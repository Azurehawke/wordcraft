# Settings for craft_mcp_bridge.py (systemd: EnvironmentFile=/etc/craft-mcp-bridge.env).
# Lines starting with # are ignored. Paths must be absolute.

# Where the bridge listens. 8090 is the existing Excel/GridCraft port; Word is on the same port
# at /word/mcp.
CRAFT_MCP_HOST=0.0.0.0
CRAFT_MCP_PORT=8090

# The GridCraft binary the bridge already runs.
GRIDCRAFT_BINARY=/opt/gridcraft/bin/gridcraft-cli

# wordcraft-cli from the cli-linux-latest release.
WORDCRAFT_BINARY=/opt/wordcraft/bin/wordcraft-cli

# The folder WordCraft works in, e.g. your Syncthing copy of the Obsidian vault. Relative paths
# ("Projects/Report.docx") resolve against it, and WordCraft may only read and write inside it.
WORDCRAFT_DOCS=/srv/sync/ObsidianVault

# Name on WordCraft's tracked changes and comments.
WORDCRAFT_AUTHOR=Gemini (Obsidian)

# Seconds to wait for an answer, and minutes before an unused session's app process is closed.
CRAFT_MCP_TIMEOUT=120
CRAFT_MCP_IDLE_MINUTES=30
